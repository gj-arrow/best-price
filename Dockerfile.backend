FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Configure pip to trust PyPI (workaround for corporate SSL inspection)
RUN mkdir -p ~/.pip && echo "[global]\ntrusted-host = pypi.org\n\tfiles.pythonhosted.org\n\tpypi.python.org\n\tarchive.ubuntu.com\n\tdeb.debian.org\n\tsecurity.debian.org\n" > ~/.pip/pip.conf

# Copy requirements and install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements.txt

# Copy source code
COPY backend/. .

# Expose FastAPI default port
EXPOSE 8000

# Default command (overridden in docker-compose.yml for development)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
